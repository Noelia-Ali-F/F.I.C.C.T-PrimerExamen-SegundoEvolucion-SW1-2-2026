# Copie este archivo como .env.aws. No confirme .env.aws en Git.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=arqnova
DB_USER=arqnova
DB_PASSWORD=change_me

AUTH_TOKEN_SECRET=change_me_with_at_least_32_random_characters


# Sustituya por el dominio o IP pública real donde se abrirá ArqNova.
CORS_ALLOWED_ORIGINS=http://YOUR_AWS_HOST:8081

# PostgreSQL queda accesible solo desde la propia instancia.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PUBLIC_PORT=5432
BACKEND_PUBLIC_PORT=8080
FRONTEND_PUBLIC_PORT=8081

# Recomendado: vacío para usar el proxy Nginx del frontend.
FRONTEND_API_URL=
# Dominio HTTPS automático para habilitar micrófono y APIs seguras del navegador.
ARQNOVA_DOMAIN=18-116-164-204.sslip.io

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
