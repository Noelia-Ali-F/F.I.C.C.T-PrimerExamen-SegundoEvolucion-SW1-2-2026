# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=arqnova
DB_USER=arqnova
DB_PASSWORD=change_me

# Seguridad (use un valor aleatorio largo en producción)
AUTH_TOKEN_SECRET=change_me_with_at_least_32_random_characters

# OpenAI (sin clave se usa el respaldo determinista)

# Orígenes permitidos por el backend, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Puertos publicados por Docker
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PUBLIC_PORT=5432
BACKEND_PUBLIC_PORT=8080
FRONTEND_PUBLIC_PORT=8081

# Vacío hace que Angular consuma /api y /ws-collab mediante Nginx (recomendado)
FRONTEND_API_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low

# Gemini credentials share one project quota; Groq is an independent fallback.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_IMAGE_MODEL=qwen/qwen3.8-27b
GROQ_IMAGE_MAX_TOKENS=8192
AI_PROVIDER_TIMEOUT_SECONDS=22

# DynamoDB: activar solo después de migrar; ver docs/dynamodb.md
AWS_REGION=us-east-2
DYNAMODB_TABLE=arqnova
